# Copy to infra/.env. Switching to mainnet = change KASPA_NETWORK and use kaspa: addresses.
# Values: kaspa:testnet-10 | kaspa:mainnet
KASPA_NETWORK=kaspa:testnet-10

# Optional fixed wRPC (Borsh) URL, e.g. ws://your-node:17210. Leave empty to use the public Resolver.
KASPA_RPC_URL=

# Treasury receives Output 1 (1.5%). Must match the network prefix (kaspatest: on testnet-10).
KASGATE_TREASURY_ADDRESS=kaspatest:qreplace_with_your_testnet_treasury_address_0000000000000000

# KIP-9 storage-mass floor per output, in sompi (0.2 KAS). 0.1 KAS outputs exceed the 100,000 standard mass limit.
MIN_OUTPUT_SOMPI=20000000

# Fernet key for upstream secret headers. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Use URL-safe characters only (letters, digits, - _) because these go into connection URLs.
POSTGRES_USER=kasgate
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=kasgate
REDIS_PASSWORD=change-me-redis-password

PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
PAYMENT_MAX_AGE_SECONDS=120
KAS_USD_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=kaspa&vs_currencies=usd

# NEXT_PUBLIC_GATEWAY_URL is derived from PUBLIC_BASE_URL in docker-compose.yml (they must match exactly for wallet challenges).

# Set to false only when serving the dashboard over plain http on a host other than localhost.
KASGATE_COOKIE_SECURE=true

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For uvicorn trusts (your edge / load balancer).
# Keep 127.0.0.1 when the gateway is exposed directly; never use * on a directly exposed port.
FORWARDED_ALLOW_IPS=127.0.0.1

# Redis fixed-window rate limits. Raise or disable for local integration testing (all host traffic shares one Docker IP).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
RL_MERCHANT_CREATE_PER_HOUR=5
RL_AUTH_CHALLENGE_PER_MINUTE=10
RL_AUTH_VERIFY_PER_MINUTE=10
RL_UNPAID_PROXY_PER_MINUTE=300
