# KasGate public testnet beta environment.
# Copy to infra/.env (git-ignored) and fill the secret fields. Never commit infra/.env.
#
# Domain is a single source of truth. Preferred: kasgate.io. Fallback if that is taken: kasgate.dev.
# After you set or change KASGATE_DOMAIN, run infra/deploy/apply-domain.sh so the derived URL
# fields below stay in sync. Do not put a trailing dot or a scheme on the domain.
KASGATE_DOMAIN=kasgate.io

# Stay on testnet-10 for the public beta. Leave KASPA_RPC_URL empty to use public Kaspa nodes
# (the wRPC Resolver). Do not point this file at mainnet until the operator switches later.
KASPA_NETWORK=kaspa:testnet-10
KASPA_RPC_URL=
KASPA_CONNECT_TIMEOUT_SECONDS=6

# Output 1 of every payment. REQUIRED, and it must be a real kaspatest: address while
# KASPA_NETWORK=kaspa:testnet-10. Startup checks the prefix; use a throw-away testnet
# treasury wallet for the beta.
# Do not set a mainnet kaspa: treasury address in this file while the network is testnet-10.
KASGATE_TREASURY_ADDRESS=

MIN_OUTPUT_SOMPI=20000000

# Generate (do not leave blank in the real infra/.env):
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ENCRYPTION_KEY=
POSTGRES_USER=kasgate
POSTGRES_PASSWORD=
POSTGRES_DB=kasgate
REDIS_PASSWORD=

# Derived from KASGATE_DOMAIN by apply-domain.sh. The gateway URL is https://api.<domain>
# and the web origins are https://<domain> and https://www.<domain>.
PUBLIC_BASE_URL=https://api.kasgate.io
CORS_ORIGINS=["https://kasgate.io","https://www.kasgate.io"]

PAYMENT_MAX_AGE_SECONDS=120
KAS_USD_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=kaspa&vs_currencies=usd

# The site is HTTPS at the Cloudflare edge, so the session cookie must stay Secure.
KASGATE_COOKIE_SECURE=true

# cloudflared connects to the gateway on loopback and sends X-Forwarded-For. Trust 127.0.0.1
# so rate limits key on the real client. Never set this to * on a published port.
FORWARDED_ALLOW_IPS=127.0.0.1

RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
RL_MERCHANT_CREATE_PER_HOUR=5
RL_AUTH_CHALLENGE_PER_MINUTE=10
RL_AUTH_VERIFY_PER_MINUTE=10
RL_UNPAID_PROXY_PER_MINUTE=300

SETTLEMENT_MODE=accepted
SETTLEMENT_TIMEOUT_SECONDS=8
KASPA_RPC_TIMEOUT_SECONDS=10
REDELIVERY_WINDOW_SECONDS=600
REDELIVERY_MAX_ATTEMPTS=3
SESSION_TTL_SECONDS=604800

# Publish only on loopback. Cloudflare Tunnel is the public ingress; do not expose 3000/8000.
GATEWAY_BIND=127.0.0.1
WEB_BIND=127.0.0.1

# Optional own-node profile settings (unused for the beta; public Resolver is the default).
KASPAD_TESTNET=true
KASPAD_P2P_PORT=16211
KASPAD_RPC_BORSH_PORT=17210
KASPAD_RAM_SCALE=1.0
