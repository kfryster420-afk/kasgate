# Server-side URL used by Next route handlers to reach the gateway (docker compose: http://gateway:8000).
GATEWAY_INTERNAL_URL=http://localhost:8000
# Browser-visible gateway base URL, inlined at build time (used in displayed snippets and for the wallet-challenge
# "Domain:" check). Under docker compose this is derived from PUBLIC_BASE_URL (infra/docker-compose.yml), so do not set
# it separately there. For local dev outside compose it MUST equal the gateway PUBLIC_BASE_URL exactly: the challenge
# Domain (lowercased netloc, host[:port]) is compared as an exact string and mismatches are refused.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
# kaspa:testnet-10 | kaspa:mainnet (the short forms "testnet-10" / "mainnet" are accepted too).
NEXT_PUBLIC_KASPA_NETWORK=kaspa:testnet-10
# Set to "false" only for plain-http deployments on non-localhost hosts (session cookie is Secure by default).
KASGATE_COOKIE_SECURE=true
